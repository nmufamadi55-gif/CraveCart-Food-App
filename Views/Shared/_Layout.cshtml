<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CraveCart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CraveCart.styles.css" asp-append-version="true" />    <style>
        :root {
            --nav-ink: #182027;
            --nav-muted: #64707d;
            --nav-line: #e6e9ed;
            --nav-brand: #f05a28;
            --nav-brand-dark: #c83f17;
        }

        header.site-header {
            position: sticky;
            top: 12px;
            z-index: 120;
            width: min(1180px, calc(100% - 32px));
            margin: 14px auto 0;
        }

        header.site-header .navbar {
            display: flex !important;
            margin-bottom: 0 !important;
            border: 1px solid rgba(255, 255, 255, 0.7) !important;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.88) !important;
            box-shadow: 0 14px 34px rgba(24, 32, 39, 0.08);
            backdrop-filter: blur(18px);
        }

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--nav-ink) !important;
            font-weight: 900;
        }

        .navbar-brand img {
            width: 36px;
            height: 36px !important;
            margin-right: 0 !important;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: 0 8px 18px rgba(240, 90, 40, 0.22);
        }

        .navbar .nav-link {
            color: var(--nav-muted) !important;
            font-weight: 800;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link:focus {
            color: var(--nav-brand-dark) !important;
        }

        .portal-dropdown {
            position: relative;
            display: inline-flex;
            align-items: center;
            margin-left: 15px;
        }

        .portal-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 16px;
            border: 0;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--nav-brand), #ff8a3d);
            color: #fff;
            box-shadow: 0 12px 28px rgba(240, 90, 40, 0.26);
            cursor: pointer;
            font-weight: 900;
            transition: transform 180ms ease, box-shadow 180ms ease;
        }

        .portal-btn:hover,
        .portal-btn:focus {
            transform: translateY(-2px);
            box-shadow: 0 16px 34px rgba(240, 90, 40, 0.3);
        }

        .portal-dropdown-content {
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            display: none;
            min-width: 230px;
            overflow: hidden;
            border: 1px solid var(--nav-line);
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 18px 45px rgba(24, 32, 39, 0.14);
            backdrop-filter: blur(18px);
        }

        .portal-dropdown:hover .portal-dropdown-content,
        .portal-dropdown:focus-within .portal-dropdown-content {
            display: block;
        }

        .portal-dropdown-content a {
            display: block;
            padding: 13px 16px;
            color: var(--nav-ink);
            text-decoration: none;
            font-size: 14px;
            font-weight: 800;
        }

        .portal-dropdown-content a:hover,
        .portal-dropdown-content a:focus {
            background: #fff1e8;
            color: var(--nav-brand-dark);
        }

        .portal-dropdown-content hr {
            margin: 4px 12px;
            border-color: var(--nav-line);
            opacity: 1;
        }

        footer.footer {
            display: block !important;
            position: static;
            width: min(1180px, calc(100% - 32px));
            margin: 0 auto 24px;
            padding: 16px 0;
            color: var(--nav-muted) !important;
        }

        @@media (max-width: 768px) {
            header.site-header {
                top: 8px;
                width: min(100% - 20px, 720px);
            }

            header.site-header .navbar {
                border-radius: 16px;
            }

            .navbar-collapse {
                padding-top: 10px;
                text-align: center;
            }

            .portal-dropdown {
                display: block;
                margin: 10px 0 0;
            }

            .portal-dropdown-content {
                position: static;
                margin-top: 8px;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/logo.png" alt="CraveCart" style="height: 30px; margin-right: 10px;" onerror="this.style.display='none'">
                    CraveCart
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- Portal Dropdown Menu -->
                    <div class="portal-dropdown">
                        <button class="portal-btn" type="button">Login Portals</button>
                        <div class="portal-dropdown-content">
                            <a href="/Admin/Login">Admin Portal</a>
                            <a href="/Restaurant/Login">Restaurant Portal</a>
                            <a href="/Driver/Login">Driver Portal</a>
                            <hr>
                            <a href="/">Customer Portal</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CraveCart - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
