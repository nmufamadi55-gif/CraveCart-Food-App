<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CraveCart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CraveCart.styles.css" asp-append-version="true" />
    <style>
        /* Portal dropdown styles */
        .portal-dropdown {
            position: relative;
            display: inline-block;
            margin-left: 15px;
        }

        .portal-btn {
            background: #FF6B35;
            color: white;
            padding: 6px 15px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 500;
            font-size: 14px;
            transition: background 0.3s;
        }

            .portal-btn:hover {
                background: #e55a2b;
            }

        .portal-dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: white;
            min-width: 180px;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
            z-index: 1000;
            border-radius: 8px;
            overflow: hidden;
        }

        .portal-dropdown:hover .portal-dropdown-content {
            display: block;
        }

        .portal-dropdown-content a {
            color: #333;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            transition: background 0.3s;
            font-size: 14px;
        }

            .portal-dropdown-content a:hover {
                background-color: #FFF0EB;
                color: #FF6B35;
            }

        .portal-dropdown-content hr {
            margin: 5px 0;
            border-color: #eee;
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .navbar-collapse {
                text-align: center;
            }

            .portal-dropdown {
                margin: 10px 0;
                display: block;
                text-align: center;
            }

            .portal-dropdown-content {
                position: static;
                box-shadow: none;
                border: 1px solid #eee;
                margin-top: 5px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/logo.png" alt="CraveCart" style="height: 30px; margin-right: 10px;" onerror="this.style.display='none'">
                    CraveCart
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- Portal Dropdown Menu -->
                    <div class="portal-dropdown">
                        <button class="portal-btn"> Portals ▼</button>
                        <div class="portal-dropdown-content">
                            <a href="/Admin/Login"> Admin Portal</a>
                            <a href="/Restaurant/Login"> Restaurant Portal</a>
                            <a href="/Driver/Login"> Driver Portal</a>
                            <hr>
                            <a href="/">🍔 Customer Portal</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CraveCart - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>