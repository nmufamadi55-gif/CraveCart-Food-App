@{
    ViewData["Title"] = "Food Delivery";
}
@model List<CraveCart.Models.Restaurant>

<section class="app-shell">
    <div class="hero-panel">
        <div class="hero-copy">
            <span class="eyebrow">Fresh delivery, beautifully simple</span>
            <h1>Order the meals you crave without the clutter.</h1>
            <p>Browse local favorites, premium plates, and lighter bowls in one polished cart experience.</p>
            <div class="hero-actions">

                <a href="#restaurantsContainer" class="primary-action">
                    Explore restaurants
                </a>

                <button type="button"
                        class="secondary-action"
                        onclick="toggleCart()">
                    Open cart
                </button>
            </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <img src="/images/menu/whopper.jpg?v=real4" alt="">
            <img src="/images/menu/harvest-bowl.jpg?v=real4" alt="">
            <img src="/images/menu/sushi-rolls.jpg?v=real4" alt="">
        </div>
    </div>

    <div class="topbar">
        <a class="brand-mark" href="/">
            <img src="/images/logo.png?v=real4" alt="CraveCart logo">
            <span>CraveCart</span>
        </a>
        <div class="topbar-actions">
            <span class="delivery-pill">Fast checkout</span>
            <button class="cart-btn" type="button" onclick="toggleCart()">
                <span>Cart</span>
                <span class="cart-count" id="cartCount">0</span>
            </button>
        </div>
    </div>

    <div class="section-heading">
        <div>
            <span class="eyebrow">Restaurants</span>
            <h2>Pick your next plate</h2>
        </div>
        <p>Every card uses local images, clear ratings, and quick access to the menu.</p>
    </div>

    <div class="category-tabs" aria-label="Restaurant categories">
        <button class="category-tab active" type="button" data-filter="All">All</button>
        <button class="category-tab" type="button" data-filter="Fast Food">Fast food</button>
        <button class="category-tab" type="button" data-filter="Premium">Premium</button>
        <button class="category-tab" type="button" data-filter="Healthy">Healthy</button>
    </div>

    <div class="restaurant-container" id="restaurantsContainer"></div>
</section>

<div id="restaurantModal" class="modal">
    <div class="modal-content restaurant-modal">
        <div class="modal-header">
            <div id="modalTitle"></div>
            <button class="icon-btn" type="button" onclick="closeModal()" aria-label="Close menu">x</button>
        </div>
        <div id="menuList" class="menu-list"></div>
    </div>
</div>

<div id="customModal" class="modal">
    <div class="modal-content custom-modal" id="customContent"></div>
</div>

<aside id="cartSidebar" class="cart-sidebar" aria-label="Shopping cart">
    <div class="cart-header">
        <div>
            <span class="eyebrow">Checkout</span>
            <h3>Your Cart</h3>
        </div>
        <button class="icon-btn" type="button" onclick="closeCart()" aria-label="Close cart">x</button>
    </div>

    <div id="cartItems"></div>
    <div id="cartSummary"></div>

    <div class="save-load-buttons">
        <button type="button" onclick="saveCart()">Save cart</button>
        <button type="button" onclick="loadCartSave()">Load cart</button>
    </div>

    <div id="notificationPanel" class="notification-panel">
        <h4>Order Status</h4>
        <div id="orderNotifications"></div>
    </div>

    <div class="cart-footer-actions">
        <button type="button" onclick="clearCart()">Clear cart</button>
        <button type="button" onclick="closeCart()">Continue browsing</button>
    </div>
</aside>

<div id="driverFloatingPanel" class="driver-floating-panel">
    <button class="close-driver" type="button" onclick="closeDriverPanel()" aria-label="Close tracking">x</button>
    <h4>Live Driver Tracking</h4>
    <div class="driver-info-row">
        <span class="driver-label">Driver</span>
        <span class="driver-value" id="driverName">-</span>
    </div>
    <div class="driver-info-row">
        <span class="driver-label">Status</span>
        <span class="driver-value" id="driverStatus">-</span>
    </div>
    <div class="driver-info-row">
        <span class="driver-label">ETA</span>
        <span class="driver-value" id="driverEta">-</span>
    </div>
    <div class="progress-bar-container">
        <div class="progress-bar" id="etaProgress"></div>
    </div>
    <div id="driverHistory" class="driver-history">
        <span>Waiting for order...</span>
    </div>
</div>

<div id="overlay" class="overlay" onclick="closeCart()"></div>
<div id="toast" class="toast"></div>

<script>
    window.craveCartRestaurants = @Html.Raw(Json.Serialize(Model));
</script>
.hero-actions {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.primary-action,
.secondary-action {
    background: #ff512f;
    color: white;
    padding: 14px 24px;
    border-radius: 14px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-weight: bold;
    transition: 0.3s ease;
    display: inline-block;
}

.primary-action:hover,
.secondary-action:hover {
    background: #e64525;
    transform: translateY(-2px);
}