@{
    ViewData["Title"] = "Driver Dashboard - CraveCart";
    Layout = "~/Views/Shared/_DriverLayout.cshtml";
}
@model CraveCart.Models.Driver.DriverUser

<div class="dashboard-container">
    <div class="welcome-header">
        <h1>Welcome back, @Model.Name! 🚚</h1>
        <p>Ready for your next delivery?</p>
    </div>

    <!-- Status Card -->
    <div class="status-card">
        <div class="status-indicator @(Model.CurrentStatus == "Online" ? "online" : "offline")"></div>
        <div class="status-info">
            <div class="status-label">Current Status</div>
            <div class="status-value">@Model.CurrentStatus</div>
        </div>
        <button class="btn-toggle-status" onclick="toggleStatus()">
            @(Model.CurrentStatus == "Online" ? "Go Offline" : "Go Online")
        </button>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-value">@Model.TotalDeliveries</div>
            <div class="stat-label">Total Deliveries</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-value">R @Model.TotalEarnings.ToString("N0")</div>
            <div class="stat-label">Total Earnings</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-value">@Model.Rating.ToString("F1")</div>
            <div class="stat-label">Rating</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🚗</div>
            <div class="stat-value">@Model.VehicleType</div>
            <div class="stat-label">Vehicle</div>
        </div>
    </div>

    <!-- Available Deliveries -->
    <div class="available-deliveries">
        <h3>📦 Available Deliveries Near You</h3>
        <div id="availableTasksList">
            <div class="loading">Loading available deliveries...</div>
        </div>
    </div>

    <!-- Active Delivery -->
    @if (ViewBag.ActiveTask != null)
    {
        <div class="active-delivery">
            <h3>🚚 Active Delivery</h3>
            <div class="delivery-progress">
                <div class="progress-steps">
                    <div class="step active">📍 Assigned</div>
                    <div class="step">🏪 Pickup</div>
                    <div class="step">🏠 Delivery</div>
                    <div class="step">✅ Complete</div>
                </div>
                <div class="delivery-details">
                    <p><strong>Restaurant:</strong> @ViewBag.ActiveTask.RestaurantName</p>
                    <p><strong>Customer:</strong> @ViewBag.ActiveTask.CustomerName</p>
                    <p><strong>Address:</strong> @ViewBag.ActiveTask.CustomerAddress</p>
                    <p><strong>Delivery Fee:</strong> R @ViewBag.ActiveTask.DeliveryFee.ToString("N2")</p>
                    <button class="btn-proceed" onclick="proceedToNextStep()">
                        Mark as Picked Up
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h3>Quick Actions</h3>
        <div class="action-buttons">
            <a href="/Driver/AvailableDeliveries" class="action-btn">🔍 Find Deliveries</a>
            <a href="/Driver/Earnings" class="action-btn">💰 View Earnings</a>
            <a href="/Driver/DeliveryHistory" class="action-btn">📋 Delivery History</a>
            <a href="/Driver/Profile" class="action-btn">👤 My Profile</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Simulate location updates every 10 seconds
        setInterval(updateLocation, 10000);

        function updateLocation() {
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    fetch('/Driver/UpdateLocation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            latitude: position.coords.latitude,
                            longitude: position.coords.longitude
                        })
                    });
                });
            }
        }

        function toggleStatus() {
            let newStatus = '@Model.CurrentStatus' === 'Online' ? 'Offline' : 'Online';
            fetch(`/Driver/UpdateStatus?status=${newStatus}`, { method: 'POST' })
                .then(() => location.reload());
        }

        function proceedToNextStep() {
            let taskId = @(ViewBag.ActiveTask?.TaskId ?? 0);
            if (taskId > 0) {
                fetch(`/Driver/MarkPickedUp?taskId=${taskId}`, { method: 'POST' })
                    .then(() => location.reload());
            }
        }

        // Load available deliveries
        function loadAvailableDeliveries() {
            fetch('/Driver/AvailableDeliveries')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('availableTasksList').innerHTML = html;
                });
        }

        loadAvailableDeliveries();
        setInterval(loadAvailableDeliveries, 30000); // Refresh every 30 seconds
    </script>
}

<style>
    .dashboard-container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .welcome-header {
        margin-bottom: 30px;
    }

    .status-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .status-indicator {
        width: 16px;
        height: 16px;
        border-radius: 50%;
    }

        .status-indicator.online {
            background: #2ecc71;
            box-shadow: 0 0 10px #2ecc71;
            animation: pulse 2s infinite;
        }

        .status-indicator.offline {
            background: #e74c3c;
        }
    keyframes pulse {
        0%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }

    100% {
        opacity: 1;
    }

    }

    .btn-toggle-status {
        background: #FF6B35;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        margin-left: auto;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 15px;
        text-align: center;
    }

    .available-deliveries, .active-delivery {
        background: white;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .progress-steps {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .step {
        flex: 1;
        text-align: center;
        padding: 10px;
        background: #f5f5f5;
        color: #999;
    }

        .step.active {
            background: #FF6B35;
            color: white;
        }

    .delivery-details {
        padding: 15px;
        background: #f9f9f9;
        border-radius: 10px;
    }

    .btn-proceed {
        background: #2ecc71;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 15px;
        width: 100%;
    }

    .quick-actions {
        background: white;
        border-radius: 15px;
        padding: 20px;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 15px;
        flex-wrap: wrap;
    }

    .action-btn {
        background: #3498db;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
    }
</style>